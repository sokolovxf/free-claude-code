# FCC SmartRouter profile shared by the smart-router-v2 branch.
#
# Copy/merge these routing lines into %USERPROFILE%\\.fcc\\.env on Windows
# (or ~/.fcc/.env on macOS/Linux). Never commit real provider credentials.

FCC_CONFIG_SCHEMA=1
PORT=8083

MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
MODEL_FALLBACKS=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b,nvidia_nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,open_router/nvidia/nemotron-3-super-120b-a12b:free,groq/openai/gpt-oss-120b,cerebras/gpt-oss-120b,cloudflare/@cf/openai/gpt-oss-120b,nvidia_nim/deepseek-ai/deepseek-v4-flash-0731,nvidia_nim/z-ai/glm-5.3-flash,nvidia_nim/z-ai/glm-5.3,nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b,nvidia_nim/poolside/laguna-xs-2.1,open_router/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,open_router/google/gemma-4-31b-it:free,cloudflare/@cf/qwen/qwen3-30b-a3b-fp8,groq/qwen/qwen3.8-27b,cloudflare/@cf/qwen/qwen3.8-27b,open_router/google/gemma-4-26b-a4b-it:free,open_router/cohere/north-mini-code:free,open_router/nex-agi/nex-n2.5-pro:free,open_router/nvidia/nemotron-3.5-lightning:free,open_router/thinkingmachines/inkling:free,open_router/inclusionai/ling-3.0-flash-fin:free,open_router/nex-agi/nex-n2.5-mini:free,groq/groq/compound,groq/groq/compound-mini,open_router/poolside/laguna-s-2.1:free,open_router/poolside/laguna-xs-2.1:free,open_router/openrouter/free,open_router/nvidia/nemotron-3-ultra-550b-a55b:free,ollama_cloud/nemotron-3-super,ollama_cloud/nemotron-3-ultra,ollama_cloud/gpt-oss:120b,ollama_cloud/nemotron-3-nano:30b,ollama_cloud/gemma4:31b,open_router/qwen/qwen3.8-27b:free,open_router/thinkingmachines/inkling-small:free,open_router/dots-studio/dots-3-note-preview:free,open_router/liquid/lfm-2.5-2.6b:free,open_router/z-ai/glm-5.2:free,open_router/inclusionai/ling-3.0-flash-vl:free,open_router/inclusionai/ling-3.0-flash-sante:free,groq/openai/gpt-oss-20b,cloudflare/@cf/openai/gpt-oss-20b,cohere/command-r7b-12-2024,cohere/north-mini-code-1-0,gemini/models/gemini-3.6-flash,huggingface/openai/gpt-oss-20b,mistral/codestral-latest,sambanova/gemma-4-31B-it,siliconflow/Qwen/Qwen3-8B,cloudflare/@cf/zai-org/glm-4.7-flash,cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast,cloudflare/@cf/qwen/qwen2.5-coder-32b-instruct,cloudflare/@cf/nvidia/nemotron-3-120b-a12b,cloudflare/@cf/google/gemma-4-26b-a4b-it,cloudflare/@cf/mistralai/mistral-small-3.1-24b-instruct,cloudflare/@cf/aisingapore/gemma-sea-lion-v4-27b-it,cloudflare/@cf/meta/llama-3.1-8b-instruct-fp8,cloudflare/@cf/meta/llama-3.2-3b-instruct,groq/allam-2-7b,cohere/command-a-03-2025,cohere/command-a-reasoning-08-2025,cohere/command-r-plus-08-2024,cohere/command-r-08-2024,gemini/models/gemini-3-flash-preview,gemini/models/gemini-3.5-flash-lite,huggingface/Qwen/Qwen3.8-27B,huggingface/zai-org/GLM-5.3-Flash,mistral/codestral-2508,mistral/ministral-8b-2512
